# Read by backend/src/config.ts from the process environment (there is no .env
# loader: set these in your shell, e.g. `set PORT=3100` on Windows).

# Backend
PORT=3100
NODE_ENV=development
# CONTENT_DIR=../content

# Answer provider: deterministic (default, offline, no keys), anthropic, or bedrock
AI_PROVIDER=deterministic

# Anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Amazon Bedrock (standard AWS credential chain)
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
