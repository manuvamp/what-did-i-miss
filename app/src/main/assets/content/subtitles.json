[
  {"id": "cue_0000", "startMs": 5000, "endMs": 8000, "text": "You shouldn't have come here.", "speaker": "Michael", "sceneId": "scene_01"},
  {"id": "cue_0001", "startMs": 9000, "endMs": 12000, "text": "I had to. I got your message.", "speaker": "Sarah", "sceneId": "scene_01"},
  {"id": "cue_0002", "startMs": 15000, "endMs": 18000, "text": "That wasn't from me.", "speaker": "Michael", "sceneId": "scene_01"},
  {"id": "cue_0003", "startMs": 30000, "endMs": 34000, "text": "I've never been to that building before.", "speaker": "Michael", "sceneId": "scene_02"},
  {"id": "cue_0004", "startMs": 36000, "endMs": 40000, "text": "But you recognized the photograph.", "speaker": "Sarah", "sceneId": "scene_02"},
  {"id": "cue_0005", "startMs": 42000, "endMs": 46000, "text": "I don't know what you're talking about.", "speaker": "Michael", "sceneId": "scene_02"},
  {"id": "cue_0006", "startMs": 60000, "endMs": 64000, "text": "The key is missing.", "speaker": "Sarah", "sceneId": "scene_03"},
  {"id": "cue_0007", "startMs": 66000, "endMs": 70000, "text": "Who else knew about it?", "speaker": "Michael", "sceneId": "scene_03"},
  {"id": "cue_0008", "startMs": 120000, "endMs": 124000, "text": "I'm going down there.", "speaker": "Michael", "sceneId": "scene_04"},
  {"id": "cue_0009", "startMs": 126000, "endMs": 130000, "text": "Wait. I'm coming with you.", "speaker": "Sarah", "sceneId": "scene_04"},
  {"id": "cue_0010", "startMs": 180000, "endMs": 184000, "text": "Stay behind me.", "speaker": "Michael", "sceneId": "scene_05"},
  {"id": "cue_0011", "startMs": 186000, "endMs": 190000, "text": "What are you looking for?", "speaker": "Sarah", "sceneId": "scene_05"},
  {"id": "cue_0012", "startMs": 240000, "endMs": 244000, "text": "The cabinet. Open it.", "speaker": "Michael", "sceneId": "scene_06"},
  {"id": "cue_0013", "startMs": 246000, "endMs": 250000, "text": "It's empty.", "speaker": "Sarah", "sceneId": "scene_06"},
  {"id": "cue_0014", "startMs": 252000, "endMs": 256000, "text": "No. Look behind it.", "speaker": "Michael", "sceneId": "scene_06"},
  {"id": "cue_0015", "startMs": 300000, "endMs": 304000, "text": "A photograph...", "speaker": "Sarah", "sceneId": "scene_07"},
  {"id": "cue_0016", "startMs": 306000, "endMs": 310000, "text": "This is the same building.", "speaker": "Sarah", "sceneId": "scene_07"},
  {"id": "cue_0017", "startMs": 312000, "endMs": 316000, "text": "My father used to work there.", "speaker": "Sarah", "sceneId": "scene_07"},
  {"id": "cue_0018", "startMs": 360000, "endMs": 364000, "text": "We need to leave. Now.", "speaker": "Michael", "sceneId": "scene_08"},
  {"id": "cue_0019", "startMs": 366000, "endMs": 370000, "text": "Not until you tell me the truth.", "speaker": "Sarah", "sceneId": "scene_08"},
  {"id": "cue_0020", "startMs": 420000, "endMs": 424000, "text": "I knew your father.", "speaker": "Michael", "sceneId": "scene_09"},
  {"id": "cue_0021", "startMs": 426000, "endMs": 430000, "text": "That's why I asked you to come.", "speaker": "Michael", "sceneId": "scene_09"},
  {"id": "cue_0022", "startMs": 480000, "endMs": 484000, "text": "The signal. It's still active.", "speaker": "Sarah", "sceneId": "scene_10"},
  {"id": "cue_0023", "startMs": 486000, "endMs": 490000, "text": "Then we're not alone here.", "speaker": "Michael", "sceneId": "scene_10"}
]
