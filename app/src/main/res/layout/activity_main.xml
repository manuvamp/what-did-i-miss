<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_background">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="true"
        app:show_buffering="when_playing"
        app:show_subtitle_button="true" />

    <LinearLayout
        android:id="@+id/debugOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:background="#80000000"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/debugTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/debugPosition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/debugDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/debugScene"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- RECAP OVERLAY -->
    <FrameLayout
        android:id="@+id/recapOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/overlay_background"
        android:visibility="gone"
        android:focusable="true"
        android:clickable="true">

        <ScrollView
            android:layout_width="640dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:maxHeight="700dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1A1A1A"
                android:orientation="vertical"
                android:padding="48dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="WHAT YOU MISSED"
                    android:textColor="@color/accent"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.2"
                    android:layout_marginBottom="24dp" />

                <TextView
                    android:id="@+id/recapTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="18sp"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/recapSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:lineSpacingMultiplier="1.4"
                    android:layout_marginBottom="24dp" />

                <TextView
                    android:id="@+id/recapImportant"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#2A2A2A"
                    android:padding="16dp"
                    android:textColor="@color/accent"
                    android:textSize="18sp"
                    android:visibility="gone"
                    android:layout_marginBottom="24dp" />

                <ProgressBar
                    android:id="@+id/recapLoading"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/recapLoadingText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/analyzing"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:visibility="gone"
                    android:layout_marginTop="12dp" />

                <!-- FOLLOW-UP QUESTION CHIPS -->
                <TextView
                    android:id="@+id/questionsLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ASK A FOLLOW-UP"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:letterSpacing="0.15"
                    android:visibility="gone"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:id="@+id/questionChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginBottom="24dp">

                    <Button
                        android:id="@+id/chipWhy"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="8dp"
                        android:backgroundTint="#2A2A2A"
                        android:text="Why is that important?"
                        android:textColor="@color/white"
                        android:textSize="15sp" />

                    <Button
                        android:id="@+id/chipClues"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="8dp"
                        android:backgroundTint="#2A2A2A"
                        android:text="What clues do we know?"
                        android:textColor="@color/white"
                        android:textSize="15sp" />

                    <Button
                        android:id="@+id/chipWho"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="8dp"
                        android:backgroundTint="#2A2A2A"
                        android:text="Who is involved?"
                        android:textColor="@color/white"
                        android:textSize="15sp" />

                    <Button
                        android:id="@+id/chipEarlier"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:backgroundTint="#2A2A2A"
                        android:text="What happened earlier?"
                        android:textColor="@color/white"
                        android:textSize="15sp" />
                </LinearLayout>

                <!-- QUESTION ANSWER -->
                <ProgressBar
                    android:id="@+id/questionLoading"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/questionAnswer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#222222"
                    android:padding="16dp"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:lineSpacingMultiplier="1.3"
                    android:visibility="gone"
                    android:layout_marginBottom="24dp" />

                <Button
                    android:id="@+id/continueButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:backgroundTint="@color/accent"
                    android:text="@string/continue_watching"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/watchMissedButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#333333"
                    android:text="@string/watch_missed_part"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <Button
        android:id="@+id/whatDidIMissButton"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="32dp"
        android:backgroundTint="@color/accent"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:text="@string/what_did_i_miss"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:focusable="true" />
</FrameLayout>
