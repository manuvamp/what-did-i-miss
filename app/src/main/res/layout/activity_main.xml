<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_background">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="true"
        app:show_buffering="when_playing"
        app:show_subtitle_button="true" />

    <LinearLayout
        android:id="@+id/debugOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:background="#80000000"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/debugTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/debugPosition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/debugDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/debugScene"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- RECAP OVERLAY: story on the left, actions on the right, sized to fit a TV screen -->
    <FrameLayout
        android:id="@+id/recapOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/overlay_background"
        android:visibility="gone"
        android:focusable="true"
        android:clickable="true">

        <ScrollView
            android:layout_width="880dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1A1A1A"
                android:orientation="horizontal"
                android:padding="32dp">

                <!-- LEFT: what happened -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.15"
                    android:layout_marginEnd="32dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="WHAT YOU MISSED"
                        android:textColor="@color/accent"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.2"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/recapTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textSize="15sp"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/recapSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp"
                        android:lineSpacingMultiplier="1.3"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:id="@+id/recapImportant"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#2A2A2A"
                        android:padding="12dp"
                        android:textColor="@color/accent"
                        android:textSize="15sp"
                        android:visibility="gone"
                        android:layout_marginBottom="16dp" />

                    <ProgressBar
                        android:id="@+id/recapLoading"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/recapLoadingText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/analyzing"
                        android:textColor="@color/text_secondary"
                        android:textSize="16sp"
                        android:gravity="center"
                        android:visibility="gone"
                        android:layout_marginTop="12dp" />

                    <!-- QUESTION ANSWER -->
                    <ProgressBar
                        android:id="@+id/questionLoading"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/questionAnswer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#222222"
                        android:padding="12dp"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:lineSpacingMultiplier="1.3"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- RIGHT: what to do next -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/continueButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:backgroundTint="@color/accent"
                        android:text="@string/continue_watching"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/watchMissedButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginBottom="12dp"
                        android:backgroundTint="#333333"
                        android:text="@string/watch_missed_part"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:visibility="gone" />

                    <!-- VISUAL RECAP: key moments from the last 2 / 5 / 10 minutes -->
                    <TextView
                        android:id="@+id/visualLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/visual_recap"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:letterSpacing="0.15"
                        android:visibility="gone"
                        android:layout_marginBottom="2dp" />

                    <LinearLayout
                        android:id="@+id/visualButtons"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        android:layout_marginBottom="12dp">

                        <Button
                            android:id="@+id/visual2Button"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:backgroundTint="#2A2A2A"
                            android:text="@string/last_2_min"
                            android:textColor="@color/white"
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/visual5Button"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:backgroundTint="#2A2A2A"
                            android:text="@string/last_5_min"
                            android:textColor="@color/white"
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/visual10Button"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:backgroundTint="#2A2A2A"
                            android:text="@string/last_10_min"
                            android:textColor="@color/white"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- FOLLOW-UP QUESTION CHIPS (2 x 2) -->
                    <TextView
                        android:id="@+id/questionsLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ASK A FOLLOW-UP"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:letterSpacing="0.15"
                        android:visibility="gone"
                        android:layout_marginBottom="2dp" />

                    <LinearLayout
                        android:id="@+id/questionChips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/chipWhy"
                                android:layout_width="0dp"
                                android:layout_height="52dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="4dp"
                                android:backgroundTint="#2A2A2A"
                                android:text="Why is that important?"
                                android:textColor="@color/white"
                                android:textSize="12sp" />

                            <Button
                                android:id="@+id/chipClues"
                                android:layout_width="0dp"
                                android:layout_height="52dp"
                                android:layout_weight="1"
                                android:backgroundTint="#2A2A2A"
                                android:text="What clues do we know?"
                                android:textColor="@color/white"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/chipWho"
                                android:layout_width="0dp"
                                android:layout_height="52dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="4dp"
                                android:backgroundTint="#2A2A2A"
                                android:text="Who is involved?"
                                android:textColor="@color/white"
                                android:textSize="12sp" />

                            <Button
                                android:id="@+id/chipEarlier"
                                android:layout_width="0dp"
                                android:layout_height="52dp"
                                android:layout_weight="1"
                                android:backgroundTint="#2A2A2A"
                                android:text="What happened earlier?"
                                android:textColor="@color/white"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <Button
        android:id="@+id/whatDidIMissButton"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="32dp"
        android:backgroundTint="@color/accent"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:text="@string/what_did_i_miss"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:focusable="true" />

    <!-- VISUAL RECAP MONTAGE: real frames with subtitle-style captions -->
    <FrameLayout
        android:id="@+id/visualRecapOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ImageView
            android:id="@+id/visualImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="32dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/visualProgress"
                android:layout_width="240dp"
                android:layout_height="3dp"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/visualHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:letterSpacing="0.2"
                android:shadowColor="@color/black"
                android:shadowRadius="6"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/visualScene"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:shadowColor="@color/black"
                android:shadowRadius="6"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/visualCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="40dp"
            android:maxWidth="760dp"
            android:background="#B3000000"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:textColor="@color/white"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="12dp"
            android:text="@string/visual_hint"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </FrameLayout>
</FrameLayout>
