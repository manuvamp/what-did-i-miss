{
  "name": "what-did-i-miss-backend",
  "version": "1.0.0",
  "description": "Backend for What Did I Miss? Fire TV app",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ingest:subtitles": "tsx ../scripts/ingest_subtitles.ts",
    "validate:content": "tsx ../scripts/validate_content.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "zod": "^3.22.4"
  },
  "optionalDependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.500.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
